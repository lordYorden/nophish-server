# ─────────────────────────────────────────────
# Stage 1: install dependencies with uv
# ─────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder

WORKDIR /app

# Copy only the dependency manifests first (leverages layer cache)
COPY pyproject.toml uv.lock ./

# Install all project dependencies into /venv (no editable install yet)
RUN uv sync --frozen --no-install-project --no-dev

# ─────────────────────────────────────────────
# Stage 2: production image
# ─────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app

# Copy the pre-built virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy the full application source
COPY . .

# Tell uv (and Python) to use the pre-built venv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV PYTHONUNBUFFERED=1

# HuggingFace model cache – can be overridden at runtime via a volume
ENV HF_HOME=/app/.hf_cache

# The ARQ worker is the only entrypoint for this image
CMD ["uv", "run", "arq", "app.detectors.tasks.WorkerSettings", "--verbose"]
